<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:gravity="top"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="1"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="40dp"
        android:paddingStart="6dp"
        >
        <TextView
            android:id="@+id/player1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_1"
            android:textSize="18sp"
            android:layout_weight="0.5"
            android:textColor="@color/white"
            />
        <TextView
            android:id="@+id/player2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_2"
            android:textSize="18sp"
            android:layout_weight="0.5"
            android:gravity="end"
            android:textColor="@color/white"
            />
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake1X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.25"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake1Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.0375"
            />
        <androidx.constraintlayout.widget.Guideline
        android:id="@+id/snake2X"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake2Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.03"
            />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake3X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.44"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake3Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.15"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake4X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.25"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake4Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.11"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake5X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.05"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake5Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.239"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake6X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.05"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake6Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.439"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake7X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.27"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake7Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.55"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake8X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.65"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake8Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.35"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake9X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.67"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake9Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.75"
            />
        <GridLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:rowCount="5"
            android:columnCount="5"
            android:layout_gravity="center"
            android:background="@drawable/grid_border"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.235"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake1"
            android:rotation="315"
            app:layout_constraintStart_toStartOf="@id/snake2X"
            app:layout_constraintTop_toTopOf="@id/snake2Y"
            />
        <ImageView
            android:layout_height="0dp"
            android:layout_width="0dp"
            app:layout_constraintHeight_percent="0.225"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake2"
            android:rotation="120"
            app:layout_constraintStart_toStartOf="@id/snake1X"
            app:layout_constraintTop_toTopOf="@+id/snake1Y"
            />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.235"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake1"
            android:rotation="315"
            app:layout_constraintStart_toStartOf="@id/snake4X"
            app:layout_constraintTop_toTopOf="@id/snake4Y"
            />
        <ImageView
            android:layout_height="0dp"
            android:layout_width="0dp"
            app:layout_constraintHeight_percent="0.225"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake2"
            android:rotation="205"
            app:layout_constraintStart_toStartOf="@id/snake3X"
            app:layout_constraintTop_toTopOf="@+id/snake3Y"
            />
        <ImageView
            android:layout_height="0dp"
            android:layout_width="0dp"
            app:layout_constraintHeight_percent="0.225"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake2"
            android:rotation="120"
            app:layout_constraintStart_toStartOf="@id/snake5X"
            app:layout_constraintTop_toTopOf="@+id/snake5Y"
            />
        <ImageView
            android:layout_height="0dp"
            android:layout_width="0dp"
            app:layout_constraintHeight_percent="0.225"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake2"
            android:rotation="120"
            app:layout_constraintStart_toStartOf="@id/snake6X"
            app:layout_constraintTop_toTopOf="@+id/snake6Y"
            />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.235"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake1"
            android:rotation="35"
            app:layout_constraintStart_toStartOf="@id/snake7X"
            app:layout_constraintTop_toTopOf="@id/snake7Y"
            />
        <ImageView
            android:layout_height="0dp"
            android:layout_width="0dp"
            app:layout_constraintHeight_percent="0.225"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake2"
            android:rotation="205"
            app:layout_constraintStart_toStartOf="@id/snake8X"
            app:layout_constraintTop_toTopOf="@+id/snake8Y"
            />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.235"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake1"
            android:rotation="35"
            app:layout_constraintStart_toStartOf="@id/snake9X"
            app:layout_constraintTop_toTopOf="@id/snake9Y"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        android:id="@+id/player_turn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/player_turn"
        android:textSize="20sp"
        android:layout_gravity="center"
        android:textColor="@color/white"
        />

    <ImageView
        android:id="@+id/dice_image"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:clickable="true"
        android:contentDescription="@string/dice_description"
        android:focusable="true"
        android:src="@drawable/dice_one" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        >
        <Button
            android:id="@+id/reset_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@drawable/grid_border"
            android:textColor="@color/white"
            android:text="@string/reset_game"/>

    </LinearLayout>

</LinearLayout>
