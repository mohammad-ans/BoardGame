<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:gravity="top"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="1"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        android:paddingStart="6dp"
        >
        <TextView
            android:id="@+id/player1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_1"
            android:textSize="18sp"
            android:layout_weight="0.5"
            android:textColor="@color/white"
            />
        <TextView
            android:id="@+id/player2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_2"
            android:textSize="18sp"
            android:layout_weight="0.5"
            android:gravity="end"
            android:textColor="@color/white"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_weight="1"
        android:weightSum="10">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_weight="8">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake1X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.3"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake1Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="-0.01"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake2X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.7"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake2Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="-0.02"
            />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake3X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.54"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake3Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.1"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake4X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.3"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake4Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.069"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake5X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.1"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake5Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.19"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake6X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.09"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake6Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.40"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake7X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.365"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake7Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.5"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake8X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.745"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake8Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.315"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake9X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.765"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/snake9Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.715"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/stair1X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.7"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/stair1Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="-0.018"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/stair2X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.1"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/stair2Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.39"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/stair3X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.1"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/stair3Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.06"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/stair4X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.51"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/stair4Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.68"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/stair5X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.69"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/stair5Y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.36"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/player1X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/player2X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.14"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/playerY"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.99"/>
        <GridLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:rowCount="5"
            android:columnCount="5"
            android:layout_gravity="center"
            android:background="@drawable/grid_border"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.335"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake1"
            android:rotation="310"
            app:layout_constraintStart_toStartOf="@id/snake2X"
            app:layout_constraintTop_toTopOf="@id/snake2Y"
            />
        <ImageView
            android:layout_height="0dp"
            android:layout_width="0dp"
            app:layout_constraintHeight_percent="0.325"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake2"
            android:rotation="112"
            app:layout_constraintStart_toStartOf="@id/snake1X"
            app:layout_constraintTop_toTopOf="@+id/snake1Y"
            />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.335"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake1"
            android:rotation="300"
            app:layout_constraintStart_toStartOf="@id/snake4X"
            app:layout_constraintTop_toTopOf="@id/snake4Y"
            />
        <ImageView
            android:layout_height="0dp"
            android:layout_width="0dp"
            app:layout_constraintHeight_percent="0.325"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake2"
            android:rotation="220"
            app:layout_constraintStart_toStartOf="@id/snake3X"
            app:layout_constraintTop_toTopOf="@+id/snake3Y"
            />
        <ImageView
            android:layout_height="0dp"
            android:layout_width="0dp"
            app:layout_constraintHeight_percent="0.325"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake2"
            android:rotation="112"
            app:layout_constraintStart_toStartOf="@id/snake5X"
            app:layout_constraintTop_toTopOf="@+id/snake5Y"
            />
        <ImageView
            android:layout_height="0dp"
            android:layout_width="0dp"
            app:layout_constraintHeight_percent="0.325"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake2"
            android:rotation="112"
            app:layout_constraintStart_toStartOf="@id/snake6X"
            app:layout_constraintTop_toTopOf="@+id/snake6Y"
            />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.335"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake1"
            android:rotation="52"
            app:layout_constraintStart_toStartOf="@id/snake7X"
            app:layout_constraintTop_toTopOf="@id/snake7Y"
            />
        <ImageView
            android:layout_height="0dp"
            android:layout_width="0dp"
            app:layout_constraintHeight_percent="0.325"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake2"
            android:rotation="215"
            app:layout_constraintStart_toStartOf="@id/snake8X"
            app:layout_constraintTop_toTopOf="@+id/snake8Y"
            />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.335"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/snake1"
            android:rotation="52"
            app:layout_constraintStart_toStartOf="@id/snake9X"
            app:layout_constraintTop_toTopOf="@id/snake9Y"
            />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/stair"
            android:rotation="52"
            app:layout_constraintHeight_percent="0.45"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="@id/stair1X"
            app:layout_constraintTop_toTopOf="@id/stair1Y"
            />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:rotation="62"
            android:src="@drawable/stair"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.55"
            app:layout_constraintStart_toStartOf="@id/stair2X"
            app:layout_constraintTop_toTopOf="@id/stair2Y" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:rotation="315"
            android:src="@drawable/stair"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.38"
            app:layout_constraintStart_toStartOf="@id/stair3X"
            app:layout_constraintTop_toTopOf="@id/stair3Y" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:rotation="62"
            android:src="@drawable/stair"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.38"
            app:layout_constraintStart_toStartOf="@id/stair4X"
            app:layout_constraintTop_toTopOf="@id/stair4Y" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:rotation="315"
            android:src="@drawable/stair"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.38"
            app:layout_constraintStart_toStartOf="@id/stair5X"
            app:layout_constraintTop_toTopOf="@id/stair5Y" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:id="@+id/player2icon"
            android:src="@drawable/player_2"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.1"
            app:layout_constraintStart_toStartOf="@id/player2X"
            app:layout_constraintBottom_toBottomOf="@id/playerY"
            />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:id="@+id/player1icon"
            android:src="@drawable/player2"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.1"
            app:layout_constraintStart_toStartOf="@id/player1X"
            app:layout_constraintBottom_toBottomOf="@id/playerY"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:paddingLeft="15dp"
        android:layout_weight="2"
        >

        <TextView
            android:id="@+id/player_turn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/player_turn"
            android:textSize="20sp"
            android:textColor="@color/white"
            app:layout_constraintBottom_toTopOf="@id/dice_image"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <ImageView
            android:id="@+id/dice_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:clickable="true"
            android:contentDescription="@string/dice_description"
            android:focusable="true"
            android:src="@drawable/dice_one"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

        <Button
            android:id="@+id/reset_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/grid_border"
            android:padding="12dp"
            android:layout_marginBottom="10dp"
            android:text="@string/reset_game"
            android:textColor="@color/white"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/dice_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>


</LinearLayout>
</LinearLayout>
